{
  "name": "@geist/icons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "fonts",
    "selection.json",
    "style.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./style.css",
    "./selection.json": "./selection.json",
    "./fonts/*": "./fonts/*"
  },
  "sideEffects": [
    "./style.css",
    "./fonts/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:data": "node scripts/generate-icon-data.mjs"
  }
}
