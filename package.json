{
  "name": "turbo-design-system",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "storybook": "corepack pnpm --filter @turbo/storybook storybook",
    "registry:sync": "tsx ./scripts/sync-design-system-registry.ts",
    "design-system:api": "corepack pnpm --filter v2-design-system-cli serve",
    "storybook:add": "corepack pnpm --filter @turbo/storybook exec storybook add --config-dir .storybook",
    "typecheck": "turbo run typecheck",
    "validate:registry": "corepack pnpm --filter @turbo/contracts validate:registry"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "tsx": "*",
    "turbo": "*",
    "typescript": "*"
  }
}
